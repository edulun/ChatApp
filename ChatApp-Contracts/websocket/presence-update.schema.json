{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PresenceUpdateEvent",
  "description": "server → client. A contact's online/offline status changed — see ChatApp-Service/DESIGN.md §6.",
  "type": "object",
  "properties": {
    "type": { "const": "presence.update" },
    "userId": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["online", "offline"] }
  },
  "required": ["type", "userId", "status"],
  "additionalProperties": false
}

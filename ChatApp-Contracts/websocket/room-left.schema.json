{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoomLeftEvent",
  "description": "server → client. Sent when a member leaves or is removed from a room.",
  "type": "object",
  "properties": {
    "type": { "const": "room.left" },
    "roomId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid", "description": "The user who left." }
  },
  "required": ["type", "roomId", "userId"],
  "additionalProperties": false
}
